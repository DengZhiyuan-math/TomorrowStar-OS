{"$defs": {"BoundaryDecision": {"additionalProperties": false, "description": "A data-only decision bound to the exact displayed question and answer.", "properties": {"schema_version": {"const": "audit-boundary-decision/v1", "title": "Schema Version", "type": "string"}, "question_id": {"pattern": "^question-[a-z0-9-]+$", "title": "Question Id", "type": "string"}, "answer": {"minLength": 1, "title": "Answer", "type": "string"}, "outcome": {"enum": ["established", "incomplete", "attribution-signal"], "title": "Outcome", "type": "string"}, "rationale": {"minLength": 1, "title": "Rationale", "type": "string"}, "strongest_capability": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Strongest Capability"}, "next_higher_not_established": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Next Higher Not Established"}}, "required": ["schema_version", "question_id", "answer", "outcome", "rationale", "strongest_capability", "next_higher_not_established"], "title": "BoundaryDecision", "type": "object"}, "CalibrationObservation": {"additionalProperties": false, "properties": {"case_id": {"title": "Case Id", "type": "string"}, "route": {"enum": ["capability", "request-context", "attribution"], "title": "Route", "type": "string"}, "boundary": {"anyOf": [{"$ref": "#/$defs/BoundaryDecision"}, {"type": "null"}]}, "supported_anchor_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Supported Anchor Id"}, "rationale": {"minLength": 1, "title": "Rationale", "type": "string"}}, "required": ["case_id", "route", "boundary", "supported_anchor_id", "rationale"], "title": "CalibrationObservation", "type": "object"}}, "additionalProperties": false, "properties": {"observations": {"items": {"$ref": "#/$defs/CalibrationObservation"}, "minItems": 1, "title": "Observations", "type": "array"}}, "required": ["observations"], "title": "ObservationBatch", "type": "object"}