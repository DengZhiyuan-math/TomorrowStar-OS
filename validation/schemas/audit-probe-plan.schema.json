{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contribution_id", "areas"],
  "properties": {
    "schema_version": {"const": "audit-probe-plan/v1"},
    "contribution_id": {"type": "string", "pattern": "^contrib-[a-z0-9-]+$"},
    "question_layer": {"enum": ["project-depth", "transfer"]},
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area_id", "inspected_fact_ids", "unverified_capability", "demanding_prompt", "intermediate_prompt", "simple_prompt", "immediately_higher_capability"],
        "properties": {
          "schema_version": {"const": "audit-probe-area/v1"},
          "area_id": {"enum": ["technical-design", "implementation", "research-development", "debugging", "operation", "organization", "collaboration"]},
          "inspected_fact_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "unverified_capability": {"type": "string", "minLength": 1},
          "demanding_prompt": {"type": "string", "minLength": 1},
          "intermediate_prompt": {"type": "string", "minLength": 1},
          "simple_prompt": {"type": "string", "minLength": 1},
          "immediately_higher_capability": {"type": "string", "minLength": 1},
          "changed_condition": {"type": "string", "minLength": 1},
          "evaluation_criteria": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hard", "intermediate", "simple"],
            "properties": {
              "hard": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "intermediate": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "simple": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  }
}
